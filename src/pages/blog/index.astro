---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((entry) => entry.data.lang === 'zh' && entry.data.visibility === 'public')
  .sort((a, b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0));
---
<BaseLayout title="博客 | 王凯泽" lang="zh" alternatePath="/en/blog/">
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">Blog</p>
      <h1>研究、工具与思考</h1>
      <p class="lead">这里的文章由结构化内容自动生成；未来可直接从 Personal OS 发布。</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container narrow">
      {posts.map((post) => (
        <article class="post-preview">
          <time>{post.data.publishedAt?.toISOString().slice(0, 10)}</time>
          <h2><a href={`/blog/${post.data.contentId}/`}>{post.data.title}</a></h2>
          {post.data.description && <p>{post.data.description}</p>}
          <a class="text-link" href={`/blog/${post.data.contentId}/`}>阅读全文</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
