---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="王凯泽 | Kaize Wang" lang="zh" alternatePath="/en/">
  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">个人学术主页 · Personal OS Public Layer</p>
        <h1>王凯泽</h1>
        <p class="subtitle">研究、项目、写作与长期积累的公开窗口。</p>
        <p class="lead">这里将逐步由我的 Personal OS 驱动：私人想法、研究笔记和项目在内部成长，成熟后再以中文或英文版本发布到这里。</p>
        <div class="actions">
          <a class="button primary" href="/research/">研究</a>
          <a class="button" href="/projects/">项目</a>
          <a class="button" href="/blog/">博客</a>
        </div>
      </div>
      <aside class="profile-panel">
        <img class="profile-image" src="/images/profile.png" alt="王凯泽" />
        <div class="profile-meta">
          <strong>王凯泽 · Kaize Wang</strong>
          <span>Research · Operations · AI</span>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
