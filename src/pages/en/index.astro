---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Kaize Wang" lang="en" alternatePath="/">
  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Academic homepage · Personal OS Public Layer</p>
        <h1>Kaize Wang</h1>
        <p class="subtitle">A public window into research, projects, writing, and long-term learning.</p>
        <p class="lead">This site will gradually be powered by my Personal OS: private ideas, research notes, and projects grow internally, then selected material is published here in Chinese or English.</p>
        <div class="actions">
          <a class="button primary" href="/en/research/">Research</a>
          <a class="button" href="/en/projects/">Projects</a>
          <a class="button" href="/en/blog/">Blog</a>
        </div>
      </div>
      <aside class="profile-panel">
        <img class="profile-image" src="/images/profile.png" alt="Kaize Wang" />
        <div class="profile-meta">
          <strong>Kaize Wang · 王凯泽</strong>
          <span>Research · Operations · AI</span>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
