---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Research | Kaize Wang" lang="en" alternatePath="/research/">
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">Research</p>
      <h1>Research questions, not just keywords</h1>
      <p class="lead">This page will gradually collect research directions, questions, working papers, and public research notes. Later, it will be generated from Research objects inside Personal OS.</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container narrow article-body">
      <h2>Operations Management × AI</h2>
      <p>I am interested in inventory, supply chains, data-driven decision making, and the role of AI in structured operational decisions.</p>
      <h2>Research workflow</h2>
      <p>The long-term goal is to connect research questions, literature, experiments, findings, and writing while publishing only the mature parts that are worth sharing.</p>
    </div>
  </section>
</BaseLayout>
