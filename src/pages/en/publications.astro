---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Publications | Kaize Wang" description="Papers, manuscripts, and research notes by Kaize Wang." lang="en" alternatePath="/publications/">
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">Publications</p>
      <h1>Papers, manuscripts, and research notes</h1>
      <p class="lead">This page will grow as papers, preprints, and project reports become ready to share. Public research outputs will eventually be synchronized from Publication objects in Personal OS.</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container narrow">
      <article class="project-card">
        <p class="eyebrow">2026 · In preparation</p>
        <h2>Working papers will be added here</h2>
        <p>I am currently organizing research outputs around AI-assisted decision making, operations research, and supply-chain problems.</p>
        <div class="tag-row"><span class="tag">In preparation</span></div>
      </article>
      <div class="article-body" style="margin-top: 32px">
        <h2>How this page will be maintained</h2>
        <p>Each publication can include a short abstract, PDF and code links, citation formats, BibTeX, and links to related public projects and research notes.</p>
      </div>
    </div>
  </section>
</BaseLayout>
