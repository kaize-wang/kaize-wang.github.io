---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="CV | Kaize Wang" description="Education, research interests, skills, and contact information for Kaize Wang." lang="en" alternatePath="/cv/">
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">CV</p>
      <h1>Kaize Wang</h1>
      <p class="lead">A concise CV page for education, research interests, skills, and contact information.</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container narrow article-body">
      <h2>Education</h2>
      <p><strong>Nankai University</strong><br />Student, with research interests in artificial intelligence, operations research, and decision systems.</p>

      <h2>Research interests</h2>
      <div class="tag-row">
        <span class="tag">AI + OR</span>
        <span class="tag">Supply Chain</span>
        <span class="tag">LLM</span>
        <span class="tag">Data-driven Optimization</span>
      </div>

      <h2>Skills</h2>
      <ul>
        <li>Python, data analysis, and reproducible research workflows</li>
        <li>Optimization modeling and algorithm reading</li>
        <li>Technical writing in Chinese and English</li>
      </ul>

      <h2>Publications and projects</h2>
      <p>Please see the Publications and Projects pages for the latest organized material.</p>
      <div class="actions">
        <a class="button" href="/en/publications/">Publications</a>
        <a class="button" href="/en/projects/">Projects</a>
      </div>

      <h2>Contact</h2>
      <p><a href="mailto:kaizewang@mail.nankai.edu.cn">kaizewang@mail.nankai.edu.cn</a></p>
    </div>
  </section>
</BaseLayout>
