---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Openings | Kaize Wang" description="Research projects, reading groups, and practical collaborations." lang="en" alternatePath="/openings/">
  <section class="page-hero section">
    <div class="container narrow">
      <p class="eyebrow">Open collaboration</p>
      <h1>Research projects, reading groups, and practical collaborations</h1>
      <p class="lead">This page keeps possible collaboration directions clear and easy to evaluate.</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container project-grid">
      <article class="project-card">
        <p class="eyebrow">Research Assistant-style</p>
        <h2>AI-assisted decision-making project</h2>
        <p>Build small prototypes that connect data, optimization models, and LLM-based interfaces.</p>
        <h3>Research topics</h3>
        <ul>
          <li>Decision pipelines that combine prediction and optimization</li>
          <li>LLM interfaces for modeling and explanation</li>
          <li>Evaluation of solution quality and reliability</li>
        </ul>
        <div class="tag-row"><span class="tag">Python</span><span class="tag">Optimization</span><span class="tag">LLM</span></div>
      </article>

      <article class="project-card">
        <p class="eyebrow">Reading Group</p>
        <h2>AI, OR, and supply-chain paper reading</h2>
        <p>Choose a focused paper list, write short summaries, and discuss methods, assumptions, and possible extensions.</p>
        <ul>
          <li>For students interested in research training</li>
          <li>For people who like turning reading into questions, experiments, or prototypes</li>
        </ul>
      </article>

      <article class="project-card">
        <p class="eyebrow">How to reach out</p>
        <h2>Start with one concrete question</h2>
        <p>Send a short email with your background, the direction you are interested in, and one concrete question or project idea.</p>
        <a class="text-link" href="mailto:kaizewang@mail.nankai.edu.cn">kaizewang@mail.nankai.edu.cn</a>
      </article>
    </div>
  </section>
</BaseLayout>
